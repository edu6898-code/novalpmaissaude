{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novalpmaissaude",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "send_metrics": false
}
